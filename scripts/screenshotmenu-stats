#!/bin/bash
# ScreenshotMenu traffic & download report.
#
# Reads the nginx logs written by the screenshotmenu.nestimer.com vhost and
# reports downloads and page views, separating real visitors from bots.
#
#   screenshotmenu-stats            # summary
#   screenshotmenu-stats -v         # summary + every non-bot download
#   screenshotmenu-stats -a         # include bot traffic in the listings
#
# Both the legacy combined format and the current `vhost` format are parsed:
# every line is split on double quotes, which lands the request, status,
# referer and user-agent in the same slots regardless of the leading fields.

set -u

GH_REPO=ScreenshotMenu/ScreenshotMenu

DL_LOGS=(/var/log/screenshotmenu/downloads.log*)
SITE_LOGS=(/var/log/nginx/screenshotmenu.access.log*)
LEGACY_LOGS=(/var/log/nginx/access.log*)

VERBOSE=0
SHOW_BOTS=0
while getopts "vah" opt; do
	case $opt in
		v) VERBOSE=1 ;;
		a) SHOW_BOTS=1 ;;
		h) sed -n '2,12p' "$0"; exit 0 ;;
		*) exit 2 ;;
	esac
done

# Read a set of logs, transparently decompressing rotated ones. Missing globs
# expand to a literal pattern, so skip anything that is not a real file.
slurp() {
	local f
	for f in "$@"; do
		[ -f "$f" ] || continue
		case "$f" in
			*.gz) zcat -- "$f" ;;
			*)    cat -- "$f" ;;
		esac
	done
}

TODAY=$(date +%Y%m%d)
D7=$(date -d '7 days ago' +%Y%m%d)
D30=$(date -d '30 days ago' +%Y%m%d)

AWK_COMMON='
function logday(s,   m, d) {
	# "10/Sep/2026:13:23:38 +0000" -> 20260910
	if (match(s, /\[[0-9]{2}\/[A-Za-z]{3}\/[0-9]{4}/) == 0) return 0
	d = substr(s, RSTART + 1, RLENGTH - 1)
	split(d, m, "/")
	return sprintf("%s%02d%02d", m[3], mon[m[2]], m[1])
}
function isbot(ua) {
	if (ua == "-" || ua == "") return 1
	return tolower(ua) ~ /bot|crawl|spider|slurp|scan|censys|curl|wget|python|go-http|java\/|okhttp|headless|monitor|uptime|facebookexternalhit|fetch|libwww|perl|ruby|axios|semrush|ahrefs|mj12|dotbot|petal|yandex|zgrab|masscan|palo alto|expanse|metasr|cms-checker/
}
function isip(t) {
	return t ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || t ~ /^[0-9a-fA-F]*:[0-9a-fA-F:]+$/
}
function clientip(pre,   f, n) {
	# leading fields are either "ip - - [" (combined) or "host ip - - [" (vhost)
	n = split(pre, f, " ")
	return isip(f[1]) ? f[1] : f[2]
}
function hostof(pre,   f, n) {
	# "" for the legacy combined format, which carries no vhost
	n = split(pre, f, " ")
	return isip(f[1]) ? "" : f[1]
}
function ours(pre, p,   h) {
	# The shared legacy log mixes all four vhosts on this box, and
	# nestimer.com serves its own .dmg. Trust $host when present;
	# fall back to the filename for pre-2026-09-10 lines.
	h = hostof(pre)
	if (h != "") return h == "screenshotmenu.nestimer.com"
	return tolower(p) ~ /screenshotmenu[^\/]*\.dmg$/
}
BEGIN {
	split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mnames, " ")
	for (i = 1; i <= 12; i++) mon[mnames[i]] = i
}
{
	n = split($0, q, "\"")
	if (n < 6) next
	req = q[2]; split(q[3], st, " "); status = st[1]; bytes = st[2]
	ref = q[4]; ua = q[6]
	ip = clientip(q[1]); day = logday(q[1])
	split(req, r, " "); method = r[1]; path = r[2]
	bot = isbot(ua)
}
'

echo "════════════════════════════════════════════════════════════"
echo "  ScreenshotMenu — $(date '+%Y-%m-%d %H:%M %Z')"
echo "════════════════════════════════════════════════════════════"

# ── Downloads ───────────────────────────────────────────────────
echo
echo "▸ LEGACY .dmg HITS (old on-site URL, 302s to GitHub since 2026-09-11)"
slurp "${DL_LOGS[@]}" "${LEGACY_LOGS[@]}" "${SITE_LOGS[@]}" 2>/dev/null \
| grep -i '\.dmg' | sort -u \
| awk -v today="$TODAY" -v d7="$D7" -v d30="$D30" "$AWK_COMMON"'
{
	if (status != 200 && status != 206) next
	if (!ours(q[1], path)) next
	tot++; if (bot) btot++; else htot++
	if (!bot) {
		if (day == today) h1++
		if (day >= d7)  h7++
		if (day >= d30) h30++
		hip[ip] = 1
		if (ua ~ /Macintosh|Mac OS X/) mac++
	}
	if (day >= d30 && bot) b30++
}
END {
	printf "  today   %5d\n", h1 + 0
	printf "  7 days  %5d\n", h7 + 0
	printf "  30 days %5d\n", h30 + 0
	printf "  ─────────────\n"
	printf "  total   %5d real   (%d unique IPs, %d from a Mac)\n", htot + 0, length(hip), mac + 0
	printf "  bots    %5d       (%d in the last 30 days)\n", btot + 0, b30 + 0
}'

# ── Page views ──────────────────────────────────────────────────
SITE_SINCE=$(slurp "${SITE_LOGS[@]}" 2>/dev/null | head -1 \
	| grep -o '\[[0-9]\{2\}/[A-Za-z]\{3\}/[0-9]\{4\}' | tr -d '[')

echo
echo "▸ PAGE VIEWS (/)"
[ -n "$SITE_SINCE" ] && echo "  (per-vhost logging since $SITE_SINCE — earlier traffic is not attributable)"
slurp "${SITE_LOGS[@]}" 2>/dev/null \
| awk -v today="$TODAY" -v d7="$D7" -v d30="$D30" "$AWK_COMMON"'
{
	if (path != "/" && path !~ /^\/(index\.html)?(\?|$)/) next
	if (status != 200 && status != 304) next
	if (bot) { bots++; next }
	if (day == today) h1++
	if (day >= d7)  h7++
	if (day >= d30) h30++
	tot++; hip[ip] = 1
	if (ref != "-" && ref !~ /screenshotmenu\.nestimer\.com/) refs[ref]++
}
END {
	if (tot + bots == 0) {
		print "  no data yet — per-site logging was enabled 2026-09-10"
	} else {
		printf "  today   %5d\n", h1 + 0
		printf "  7 days  %5d\n", h7 + 0
		printf "  30 days %5d\n", h30 + 0
		printf "  ─────────────\n"
		printf "  total   %5d real   (%d unique IPs)\n", tot + 0, length(hip)
		printf "  bots    %5d\n", bots + 0
		if (length(refs) > 0) {
			print "\n  Referrers:"
			for (r in refs) printf "   %4d  %s\n", refs[r], r
		}
	}
}'

# ── GitHub releases (where the binary actually lives) ───────────
echo
echo "▸ RELEASE DOWNLOADS (GitHub)"
GH_JSON=$(curl -sf --max-time 10 \
	-H "Accept: application/vnd.github+json" \
	"https://api.github.com/repos/$GH_REPO/releases" 2>/dev/null)

if [ -z "$GH_JSON" ]; then
	echo "  GitHub API unreachable -- skipped"
elif [ "$(printf '%s' "$GH_JSON" | jq 'length')" = "0" ]; then
	echo "  no releases published yet"
else
	printf '%s' "$GH_JSON" | jq -r '
		(map([.assets[].download_count] | add // 0) | add) as $grand
		| (.[] | "  \(.tag_name)   published \(.published_at | split("T")[0])",
		         (.assets[] | "     \(.download_count | tostring | (" " * (6 - length)) + .)  \(.name)"))
		, "  -------------"
		, "  total  \($grand | tostring | (" " * (6 - length)) + .)  across all releases"
	'
fi

# ── Crawler activity (SEO health) ───────────────────────────────
echo
echo "▸ CRAWLERS"
[ -n "$SITE_SINCE" ] && echo "  (since $SITE_SINCE)"
slurp "${SITE_LOGS[@]}" 2>/dev/null \
| awk "$AWK_COMMON"'
{
	if (!bot) next
	name = "other"
	l = tolower(ua)
	if (l ~ /googlebot/)     name = "Googlebot"
	else if (l ~ /bingbot/)  name = "Bingbot"
	else if (l ~ /gptbot/)   name = "GPTBot (OpenAI)"
	else if (l ~ /claudebot|anthropic/) name = "ClaudeBot"
	else if (l ~ /ccbot/)    name = "CCBot (Common Crawl)"
	else if (l ~ /applebot/) name = "Applebot"
	else if (l ~ /yandex/)   name = "YandexBot"
	else if (l ~ /duckduck/) name = "DuckDuckBot"
	else next
	hits[name]++
	if (path ~ /sitemap|robots/) seo[name]++
}
END {
	if (length(hits) == 0) {
		print "  none of the major search engines have crawled this site"
	} else {
		for (b in hits) printf "   %4d hits  %-22s (%d on robots/sitemap)\n", hits[b], b, seo[b] + 0
	}
}'

# ── Verbose listing ─────────────────────────────────────────────
if [ "$VERBOSE" = 1 ]; then
	echo
	echo "▸ DOWNLOAD LOG"
	slurp "${DL_LOGS[@]}" "${LEGACY_LOGS[@]}" "${SITE_LOGS[@]}" 2>/dev/null \
	| grep -i '\.dmg' | sort -u \
	| awk -v showbots="$SHOW_BOTS" "$AWK_COMMON"'
	{
		if (status != 200 && status != 206) next
		if (!ours(q[1], path)) next
		if (bot && !showbots) next
		tag = bot ? "BOT " : "REAL"
		match(q[1], /\[[^]]+\]/)
		printf "  %s  %-18s %s  %.70s\n", tag, ip, substr(q[1], RSTART + 1, 20), ua
	}'
fi
echo
